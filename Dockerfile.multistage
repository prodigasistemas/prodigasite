# Stage 1: Build
FROM ruby:2.7.4 AS builder

RUN curl -fsSL https://deb.nodesource.com/setup_16.x | bash - && \
    apt-get update -qq && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN gem install bundler:1.17.1 && \
    bundle install --without development test

COPY . .

ARG RAILS_ENV=production
ENV RAILS_ENV=${RAILS_ENV}

RUN SECRET_KEY_BASE=$(bundle exec rake secret) bundle exec rake assets:precompile

# Stage 2: Production
FROM ruby:2.7.4-slim AS production

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    libsqlite3-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy gems from builder
COPY --from=builder /usr/local/bundle /usr/local/bundle

# Copy only necessary files
COPY --from=builder /app/app ./app
COPY --from=builder /app/config ./config
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/public ./public
COPY --from=builder /app/vendor ./vendor
COPY --from=builder /app/Gemfile* ./
COPY --from=builder /app/config.ru ./
COPY --from=builder /app/Rakefile ./

RUN groupadd -r rails && \
    useradd -r -g rails rails && \
    chown -R rails:rails /app

USER rails

EXPOSE 3000

CMD ["sh", "-c", "export SECRET_KEY_BASE=$(bundle exec rake secret) && bundle exec puma -C config/puma.rb"]